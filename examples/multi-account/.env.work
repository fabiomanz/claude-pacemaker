# ---- work account ----
TZ=Europe/Rome
ANCHOR=06:25             # offset a few minutes from the private stack, purely to stagger the two
ANCHOR_WEEKEND=07:25
WINDOWS=4
WINDOW_HOURS=5

MODEL=claude-haiku-4-5-20251001
PING_PROMPT=hi
MAX_TOKENS=1

FRESH_TOLERANCE_MIN=10
RETRY_INTERVAL_SEC=120
RESET_BUFFER_SEC=45
MAX_RETRIES=10
MAX_BACKOFF_SEC=1800

# The path *inside* the container. The host side is the volume mount in
# docker-compose.yml (./creds/work). Leave this alone.
CREDENTIALS=/root/.claude/.credentials.json
