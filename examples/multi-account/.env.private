# ---- private account ----
TZ=Europe/Rome
ANCHOR=06:20             # 06:20 / 11:20 / 16:20 / 21:20
ANCHOR_WEEKEND=07:20
WINDOWS=4
WINDOW_HOURS=5

MODEL=claude-haiku-4-5-20251001
PING_PROMPT=hi
MAX_TOKENS=1

FRESH_TOLERANCE_MIN=10
RETRY_INTERVAL_SEC=120
RESET_BUFFER_SEC=45
MAX_RETRIES=10
MAX_BACKOFF_SEC=1800

# The path *inside* the container. The host side is the volume mount in
# docker-compose.yml (./creds/private). Leave this alone.
CREDENTIALS=/root/.claude/.credentials.json
